#!/bin/sh
# apman-collect - periodic counter sampling, usage history, live state for UI
#
# Maintains (all tmpfs unless noted):
#   /tmp/apman/state.tsv    id \t up_bytes \t dn_bytes         (last sample)
#   /tmp/apman/today.tsv    date \t id \t up_bytes \t dn_bytes (day running)
#   /tmp/apman/rates.tsv    id \t up_bps \t dn_bps \t ts \t last_change
#   /tmp/apman/unknown.tsv  mac \t up_bytes \t dn_bytes \t last_change
#   /tmp/apman/wifi.tsv     mac (wifi-associated right now)
#   /tmp/apman/qsums.tsv    id \t day_bytes \t month_bytes  (usage caps)
#   /tmp/apman/quota.mac    mac over a daily/monthly cap (feeds nft overquota)
#   /tmp/apman/status.json  full UI payload (jshn-built)
#   /etc/apman/daily.tsv    date \t id \t up_bytes \t dn_bytes (flash, every
#                           snapshot_minutes; current + past days)
#
# Also clears expired pauses (uci + re-apply) and prunes old history.
# Usage caps: each sample recomputes per-device day/month totals and writes
# quota.mac; apman-apply is re-run only when that list changes, so wifi-only
# quota drops appear/disappear without touching anything else. Day totals
# reset at midnight, month totals on the 1st: both release automatically.
# On startup today.tsv is seeded from daily.tsv's row for today, so a reboot
# does not lose the already-flashed part of the day (and monthly sums built
# from daily.tsv stay exact).
# Test hooks: APMAN_ONCE=1 (one sample, no loop), APMAN_RUN_DIR, APMAN_DAILY_FILE

RUN=${APMAN_RUN_DIR:-/tmp/apman}
DAILY=${APMAN_DAILY_FILE:-/etc/apman/daily.tsv}
DEVS=$RUN/devices.tsv
JSHN=/usr/share/libubox/jshn.sh

mkdir -p "$RUN"
for f in state.tsv today.tsv rates.tsv unknown.tsv wifi.tsv; do
	[ -f "$RUN/$f" ] || : > "$RUN/$f"
done
[ -f "$DAILY" ] || : > "$DAILY"

# fresh boot: /tmp was wiped, so today's running totals restart from the
# last flash snapshot instead of from zero (daily.tsv keeps today's row)
seed_today() {
	[ -s "$RUN/today.tsv" ] && return 0
	[ -s "$DAILY" ] || return 0
	local d
	d=$(date +%Y-%m-%d)
	awk -F'\t' -v OFS='\t' -v d="$d" '$1 == d' "$DAILY" > "$RUN/today.tsv"
}
seed_today

# whitelist state as the UI needs it: 0 off, 1 enforcing, 2 enabled but
# inactive because no gateway MAC could be detected
wl_state() {
	local wl
	wl=$(uci -q get apman.global.whitelist)
	case "$wl" in
		0|''|false|no|off) echo 0; return 0 ;;
	esac
	nft list chain bridge apman wlguard >/dev/null 2>&1 && echo 1 || echo 2
}

read_setting() {
	local v
	v=$(uci -q get "apman.global.$1")
	[ -n "$v" ] && echo "$v" || echo "$2"
}

int_or() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }

# counter snapshot "id \t up_bytes \t dn_bytes" for managed devices
snapshot() {
	nft --terse list table bridge apman 2>/dev/null | awk -v devs="$DEVS" '
		/^\t*counter (up|dn)_[0-9a-f]+ \{/ { key = $2; sub(/\{/, "", key); want = 1; next }
		want && /packets/ {
			by = 0
			for (i = 1; i <= NF; i++) if ($i == "bytes") by = $(i + 1)
			val[key] = by; want = 0
		}
		END {
			while ((getline line < devs) > 0) {
				split(line, f, "\t"); id = f[1]
				if (id != "") printf "%s\t%d\t%d\n", id, val["up_" id] + 0, val["dn_" id] + 0
			}
		}'
}

# one unknown-set side: "mac 	 side(u|d) 	 bytes"
# NOTE: no --terse here. --terse exists to omit set elements, so it prints the
# set header and nothing else: every unknown device would be invisible.
parse_unk_set() {
	nft list set bridge apman "unknown_$1" 2>/dev/null | awk -v side="$1" '
		/elements = \{/ { ine = 1 }
		ine {
			for (i = 1; i <= NF; i++) {
				t = $i; sub(/,$/, "", t)
				if (length(t) == 17 && t ~ /^..:..:..:..:..:..$/) { mac = tolower(t); seen[mac] = 1 }
				else if (t == "bytes" && mac != "") { b = $(i + 1); sub(/,$/, "", b); val[mac] += b + 0 }
			}
		}
		END { for (m in seen) printf "%s	%s	%d\n", m, substr(side, 1, 1), val[m] + 0 }'
}

# merged: "mac 	 up 	 dn"
# set names are unknown_up / unknown_dn, so pass the full suffix
unknown_snapshot() {
	{ parse_unk_set up; parse_unk_set dn; } | awk -F'	' -v OFS='	' '
		{ if ($2 == "u") u[$1] = $3; else d[$1] = $3; macs[$1] = 1 }
		END { for (m in macs) printf "%s	%d	%d\n", m, u[m] + 0, d[m] + 0 }' | sort
}

dhcp_names() {
	# mac -> hostname from dnsmasq leases; dumb AP may relay these, may be absent
	# columns: expiry mac ip hostname <client-id>
	awk 'NF >= 4 { mac = tolower($2); gsub(/[^0-9a-f:]/, "", mac); if (mac != "") print mac "\t" $4 }' \
		/tmp/dhcp.leases 2>/dev/null
}

wifi_clients() {
	local obj
	for obj in $(ubus -S list 'hostapd.*' 2>/dev/null); do
		ubus -S call "$obj" get_clients 2>/dev/null | grep -oE '([0-9a-f]{2}:){5}[0-9a-f]{2}'
	done | tr 'A-F' 'a-f' | sort -u
}

put() { cat > "$1.tmp" && mv "$1.tmp" "$1"; }

# ---------- usage caps: day/month totals + over-quota MAC list ----------
# writes $RUN/qsums.tsv (id \t day_bytes \t month_bytes) and rebuilds
# $RUN/quota.mac; apman-apply is re-run only when that list changes
quota_step() {
	local date=$1 month=$2 id mac a b c d2 e f2 g h dm mm line du mu over
	[ -f "$DEVS" ] || return 0

	awk -F'\t' -v OFS='\t' -v d="$date" -v m="$month" '
		FILENAME == ARGV[1] {
			if (index($1, m) == 1) mon[$2] += $3 + $4
			if ($1 == d) day[$2] += $3 + $4
			ids[$2] = 1
			next
		}
		$1 == d { next }
		index($1, m) == 1 { mon[$2] += $3 + $4; ids[$2] = 1 }
		END { for (i in ids) printf "%s\t%d\t%d\n", i, day[i], mon[i] }
	' "$RUN/today.tsv" "$DAILY" > "$RUN/qsums.tsv"

	: > "$RUN/quota.mac.new"
	while IFS='	' read -r id mac a b c d2 e f2 g dm mm; do
		[ -n "$id" ] || continue
		dm=$(int_or "$dm" 0); mm=$(int_or "$mm" 0)
		[ "$dm" -gt 0 ] || [ "$mm" -gt 0 ] || continue
		line=$(awk -F'\t' -v i="$id" '$1 == i { print $2 " " $3; exit }' "$RUN/qsums.tsv")
		du=${line%% *}; mu=${line##* }
		du=$(int_or "$du" 0); mu=$(int_or "$mu" 0)
		over=0
		[ "$dm" -gt 0 ] && [ "$du" -ge $((dm * 1048576)) ] && over=1
		[ "$mm" -gt 0 ] && [ "$mu" -ge $((mm * 1048576)) ] && over=1
		[ "$over" = 1 ] && printf '%s\n' "$mac" >> "$RUN/quota.mac.new"
	done < "$DEVS"

	if [ -f "$RUN/quota.mac" ]; then
		if cmp -s "$RUN/quota.mac.new" "$RUN/quota.mac"; then
			rm -f "$RUN/quota.mac.new"
		else
			mv "$RUN/quota.mac.new" "$RUN/quota.mac"
			/usr/sbin/apman-apply
		fi
	else
		mv "$RUN/quota.mac.new" "$RUN/quota.mac"
		[ -s "$RUN/quota.mac" ] && /usr/sbin/apman-apply
	fi
}

# ---------- one sampling step (APMAN_ONCE=1 runs exactly this and exits) ----------
sample_step() {
	local date now interval cleared delta snapmin histdays keepdays lastsnap keepfrom month
	date=$(date +%Y-%m-%d)
	month=${date%-*}
	now=$(date +%s)
	interval=$(int_or "$(uci -q get apman.global.interval)" 10)
	[ "$interval" -lt 2 ] && interval=2

	if [ ! -f "$DEVS" ]; then
		# fresh boot or /tmp cleared: apman-apply regenerates the list from uci
		/usr/sbin/apman-apply >/dev/null 2>&1
		[ -f "$DEVS" ] || : > "$DEVS"
	fi

	# expired pauses -> clear + reapply
	cleared=0
	while IFS='	' read -r id mac down up lim block pause alias sec dm mm; do
		[ -n "$pause" ] || continue
		[ "$alias" = - ] && alias=
		[ "$pause" -gt 0 ] 2>/dev/null || continue
		if [ "$pause" -le "$now" ] 2>/dev/null; then
			uci -q set "apman.$sec.pause_until=0"
			cleared=1
		fi
	done < "$DEVS"
	if [ "$cleared" = 1 ]; then
		uci -q commit apman
		/usr/sbin/apman-apply
	fi

	snapshot | sort > "$RUN/.cur"

	# deltas vs last state -> .delta: id \t du \t dd \t last_change
	awk -F'\t' -v OFS='\t' -v now="$now" '
		FILENAME == ARGV[1] { pu[$1] = $2 + 0; pd[$1] = $3 + 0; next }
		{
			id = $1; u = $2 + 0; d = $3 + 0
			du = (id in pu && u >= pu[id]) ? u - pu[id] : 0
			dd = (id in pd && d >= pd[id]) ? d - pd[id] : 0
			printf "%s\t%d\t%d\t%d\n", id, du, dd, (du + dd > 0) ? now : 0
		}
	' "$RUN/state.tsv" "$RUN/.cur" | put "$RUN/.delta"
	awk -F'\t' -v OFS='\t' '{ print $1, $2, $3 }' "$RUN/.cur" | put "$RUN/state.tsv"

	# rates + online timestamps; carry last_change over idle samples
	awk -F'\t' -v OFS='\t' -v now="$now" -v iv="$interval" '
		FILENAME == ARGV[1] { last[$1] = $5 + 0; next }
		{
			id = $1
			lc = ($4 > 0) ? now : (id in last ? last[id] : 0)
			printf "%s\t%d\t%d\t%d\t%d\n", id, $2 * 8 / iv, $3 * 8 / iv, now, lc
		}
	' "$RUN/rates.tsv" "$RUN/.delta" | put "$RUN/rates.tsv"

	# persist today -> daily.tsv on cadence, or IMMEDIATELY when today.tsv still
	# holds a previous day: the rewrite below relabels rows to $date, so stale
	# rows must reach daily.tsv first (midnight rollover)
	snapmin=$(int_or "$(uci -q get apman.global.snapshot_minutes)" 10)
	histdays=$(int_or "$(uci -q get apman.global.history_days)" 30)
	# monthly usage caps are summed from daily.tsv: always retain a full
	# 31-day window even when the display setting asks for fewer days
	keepdays=$histdays
	[ "$keepdays" -lt 31 ] && keepdays=31
	lastsnap=$(int_or "$(cat "$RUN/lastsnap" 2>/dev/null)" 0)
	if [ -s "$RUN/today.tsv" ] && awk -F'\t' -v d="$date" '$1 != d { stale = 1 } END { exit !stale }' "$RUN/today.tsv"; then
		lastsnap=0
	fi
	if [ $((now - lastsnap)) -ge $((snapmin * 60)) ]; then
		keepfrom=$(date -d "@$((now - (keepdays - 1) * 86400))" +%Y-%m-%d 2>/dev/null)
		[ -n "$keepfrom" ] || keepfrom=0000-00-00
		{
			awk -F'\t' -v OFS='\t' -v d="$date" -v k="$keepfrom" '$1 != d && $1 >= k' "$DAILY"
			cat "$RUN/today.tsv"
		} | sort | put "$DAILY"
		date +%s > "$RUN/lastsnap.tmp" && mv "$RUN/lastsnap.tmp" "$RUN/lastsnap"
	fi

	# today running totals (delta data inlined: avoids empty-first-file awk trap)
	# carry forward only rows already dated today: yesterday's totals live in
	# daily.tsv now and must not leak into the new day's counter
	delta=$(cat "$RUN/.delta")
	awk -F'\t' -v OFS='\t' -v date="$date" -v delta="$delta" '
		BEGIN {
			n = split(delta, L, "\n")
			for (i = 1; i <= n; i++) {
				split(L[i], f, "\t")
				if (f[1] != "") { du[f[1]] = f[2] + 0; dd[f[1]] = f[3] + 0; ids[f[1]] = 1 }
			}
		}
		$1 == date { t[$2] = $3 + 0; td[$2] = $4 + 0; ids[$2] = 1 }
		END { for (i in ids) printf "%s\t%s\t%d\t%d\n", date, i, du[i] + t[i], dd[i] + td[i] }
	' "$RUN/today.tsv" | put "$RUN/today.tsv"

	# usage caps: recompute totals, refresh the over-quota list, re-apply
	# nft only when membership changed (see quota_step)
	quota_step "$date" "$month"

	# whitelist self-heal: enabled but not enforcing means the gateway MAC was
	# unknown when apply last ran (fresh boot, empty neighbour table). Retry at
	# most once a minute rather than leaving wifi clients unfiltered until the
	# next config change.
	if [ "$(wl_state)" = 2 ]; then
		lastwl=$(int_or "$(cat "$RUN/lastwl" 2>/dev/null)" 0)
		if [ $((now - lastwl)) -ge 60 ]; then
			date +%s > "$RUN/lastwl.tmp" && mv "$RUN/lastwl.tmp" "$RUN/lastwl"
			/usr/sbin/apman-apply >/dev/null 2>&1
		fi
	fi

	# unknown devices; carry last_change while totals unchanged.
	# set counters restart after each apman-apply (table delete+recreate):
	# when a total shrinks, treat the new value as post-reset delta
	unknown_snapshot | sort > "$RUN/.unk"
	awk -F'\t' -v OFS='\t' -v now="$now" '
		FILENAME == ARGV[1] {
			last[$1] = $4 + 0; tot[$1] = ($2 + 0) + ($3 + 0)
			prevu[$1] = $2 + 0; prevd[$1] = $3 + 0; next
		}
		{
			m = $1; u = $2 + 0; d = $3 + 0
			if (m in tot && (u + d) < tot[m]) { u += prevu[m]; d += prevd[m] }
			prevu[m] = u; prevd[m] = d
			t = u + d
			lc = (!(m in last)) ? now : (t != tot[m] ? now : last[m])
			printf "%s\t%d\t%d\t%d\n", m, u, d, lc
		}
	' "$RUN/unknown.tsv" "$RUN/.unk" | put "$RUN/unknown.tsv"

	wifi_clients > "$RUN/wifi.tsv.tmp" && mv "$RUN/wifi.tsv.tmp" "$RUN/wifi.tsv"

	build_status "$date" "$now" "$interval" "$snapmin" "$histdays"
}

build_status() {
	local date=$1 now=$2 interval=$3 snapmin=$4 histdays=$5
	[ -f "$JSHN" ] || return 0
	. "$JSHN"

	json_init
	json_add_object devices
	while IFS='	' read -r id mac down up lim block pause alias sec dm mm; do
		[ -n "$id" ] || continue
		local r bps_u bps_d lastc t_up t_dn state mu over
		r=$(awk -F'\t' -v id="$id" '$1==id {print $2 " " $3 " " $5}' "$RUN/rates.tsv")
		bps_u=${r%% *}; r=${r#* }
		bps_d=${r%% *}; r=${r#* }
		lastc=${r%% *}
		bps_u=$(int_or "$bps_u" 0); bps_d=$(int_or "$bps_d" 0); lastc=$(int_or "$lastc" 0)
		t_up=$(awk -F'\t' -v id="$id" '$2==id {print $3}' "$RUN/today.tsv")
		t_dn=$(awk -F'\t' -v id="$id" '$2==id {print $4}' "$RUN/today.tsv")
		t_up=$(int_or "$t_up" 0); t_dn=$(int_or "$t_dn" 0)
		mu=$(awk -F'\t' -v id="$id" '$1==id {print $3; exit}' "$RUN/qsums.tsv" 2>/dev/null)
		mu=$(int_or "$mu" 0)
		over=0
		grep -qix "$mac" "$RUN/quota.mac" 2>/dev/null && over=1
		state=idle
		[ "$block" = 1 ] && state=blocked
		if [ -n "$pause" ] && [ "$pause" -gt "$now" ] 2>/dev/null; then
			state=paused
		fi
		[ "$state" = idle ] && [ "$over" = 1 ] && state=capped
		if [ "$state" = idle ]; then
			if grep -qix "$mac" "$RUN/wifi.tsv" 2>/dev/null; then
				state=online
			elif [ "$lastc" -gt 0 ] && [ $((now - lastc)) -le $((interval * 3)) ]; then
				state=active
			fi
		fi
		[ "$alias" = - ] && alias=
		json_add_object "$id"
		json_add_string mac "$mac"
		json_add_string alias "$alias"
		json_add_int down_kbps "${down:-0}"
		json_add_int up_kbps "${up:-0}"
		json_add_int limit_enabled "$([ "$lim" = 1 ] && echo 1 || echo 0)"
		json_add_int block "$([ "$block" = 1 ] && echo 1 || echo 0)"
		json_add_int pause_until "${pause:-0}"
		json_add_string state "$state"
		json_add_int up_bps "$bps_u"
		json_add_int dn_bps "$bps_d"
		json_add_int today_up "$t_up"
		json_add_int today_dn "$t_dn"
		json_add_int used_month "$mu"
		json_add_int quota_daily_mb "$(int_or "$dm" 0)"
		json_add_int quota_monthly_mb "$(int_or "$mm" 0)"
		json_add_int overquota "$over"
		json_close_object
	done < "$DEVS"
	json_close_object

	json_add_object unknown
	while IFS='	' read -r mac u d lastc; do
		[ -n "$mac" ] || continue
		json_add_object "$mac"
		json_add_int up "$u"
		json_add_int dn "$d"
		json_add_int last_change "$lastc"
		json_close_object
	done < "$RUN/unknown.tsv"
	json_close_object

	json_add_object names
	while IFS='	' read -r _m _h; do
		[ -n "$_m" ] || continue
		json_add_string "$_m" "$_h"
	done <<EOF
$(dhcp_names)
EOF
	json_close_object

	json_add_object settings
	json_add_int enabled "$([ "$(uci -q get apman.global.enabled)" != 0 ] && echo 1 || echo 0)"
	json_add_int interval "$interval"
	json_add_int history_days "$histdays"
	json_add_int snapshot_minutes "$snapmin"
	json_add_string ignored_macs "$(uci -q get apman.global.ignored_macs)"
	json_add_int whitelist "$(wl_state)"
	json_add_string gateway_mac "$(nft list set bridge apman wanmac 2>/dev/null | sed -n 's/.*elements = { *\([0-9a-f:]*\).*/\1/p' | head -1)"
	json_close_object

	json_add_string date "$date"
	json_add_int ts "$now"

	json_dump > "$RUN/status.json.tmp" && mv "$RUN/status.json.tmp" "$RUN/status.json"
}

if [ -n "$APMAN_ONCE" ]; then
	sample_step
else
	while :; do
		sample_step
		interval=$(int_or "$(uci -q get apman.global.interval)" 10)
		[ "$interval" -lt 2 ] && interval=2
		sleep "$interval"
	done
fi
