#!/bin/sh /etc/rc.common
# AP Manager collector service

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/apman-collect

start_service() {
	local enabled
	config_load apman
	config_get_bool enabled global enabled 1
	[ "$enabled" -eq 1 ] || return 0

	# push the current device rules into nftables at boot
	/usr/sbin/apman-apply

	procd_open_instance collector
	procd_set_param command "$PROG"
	# respawn: threshold 3600s, retry delay 5s, max 5 retries
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger apman
}

reload_service() {
	stop
	start
}
