#!/bin/sh
# apman-apply - read UCI device config, (re)generate and load nftables rules
#
# Design (all in bridge family => independent of wired/wifi backhaul):
#   prerouting blockchain  prio -300  drop traffic of blocked/paused MACs
#                              (block/pause cuts wired AND wifi on purpose)
#   prerouting discovery   prio -250  learn unknown MACs into counting sets
#   prerouting wlguard     prio -200  whitelist mode: unknown wifi MACs keep
#                              LAN access but lose everything off-LAN. Matches
#                              the LAN prefixes the bridge carries, so it works
#                              on a bridge-mode AP with no default route; wired
#                              ports are never matched
#   prerouting lim_ul      prio -150  upload rate limits, wifi ingress only
#   prerouting quota_ul    prio -140  usage cap (daily/monthly), wifi only
#   prerouting acc_up      prio -100  upload counters, wifi ingress only
#   forward     lim_dl     prio -150  download rate limits, wifi egress only
#   forward     quota_dl   prio -140  usage cap (daily/monthly), wifi only
#   forward     acc_dn     prio -100  download counters, wifi egress only
#   output      blockchain_out       drop traffic TO blocked/paused MACs
#   output      discovery_out        count unknown MACs' downloads
#   output      lim_dl_out prio -150  download rate limits, wifi egress only
#   output      quota_dl_out prio -140 usage cap (daily/monthly), wifi only
#   output      acc_dn_out prio -100 download counters, wifi egress only
#
# Two kinds of frame reach a wifi client, and they need DIFFERENT hooks:
#   relayed : the bridge receives the frame on one port and sends it out of
#             another (dumb AP: the uplink is itself a bridge port). Seen at
#             bridge prerouting (ingress) and bridge forward (egress).
#   routed  : the AP's own IP stack routes the frame (a router: WAN is a
#             separate, non-bridge interface) and hands it to the bridge,
#             which transmits it out of the wifi port. The frame is locally
#             generated, so the bridge never "forwards" it and never sees it
#             at prerouting. It is seen at bridge output (egress) only.
#
# Everything that matches a frame ADDRESSED TO a client therefore needs
# both the forward and the output hook:
#   - the download cap and the download counters: with only the forward
#     hook a router's downloads were never limited and never counted.
#   - the block: with only the prerouting daddr rule a blocked device
#     still received inbound traffic on a router.
#   - the unknown-device download counters: same reason.
# The two hooks are mutually exclusive: a frame is either relayed or
# generated locally, never both, so nothing is ever counted twice and the
# per-device totals stay exact.
#
# Wifi-only scoping: limits and usage accounting match `iifname/oifname
# @wifports`, where wifports = bridge ports carrying a phy80211 parent.
# Upload is scoped at prerouting via iifname (ingress port known there),
# so it works in both topologies. Download needs the egress port, which is
# only known once the frame is on its way out.
# Limiter -150 and quota -140 both precede accounting -100 in their hook,
# so capped-away and quota-dropped bytes never count as usage.
#
# Regeneration is atomic (delete+recreate in one transaction) and preserves
# existing counter values. Test hooks: APMAN_DEVICES_TSV=/path.tsv skips uci,
# APMAN_WIFI_PORTS="wlan0 wlan1" overrides wifi port discovery.

RUN=${APMAN_RUN_DIR:-/tmp/apman}
# The LAN bridge. br-lan is the OpenWrt default, but a device can rename it
# (or the user can run this as a dumb AP onto a custom bridge), so it is a
# setting. APMAN_BRIDGE still wins for tests, where the fixture bridge must
# never be a real br-lan.
BRIDGE=${APMAN_BRIDGE:-$(uci -q get apman.global.bridge)}
[ -n "$BRIDGE" ] || BRIDGE=br-lan
DEVS=$RUN/devices.tsv
GEN=$RUN/apman.nft
FLUSH=$RUN/apman-flush.nft
QUOTA=$RUN/quota.mac

mkdir -p "$RUN"

[ -f /lib/functions.sh ] && . /lib/functions.sh

read_setting() {
	local v
	v=$(uci -q get "apman.global.$1")
	[ -n "$v" ] && echo "$v" || echo "$2"
}

# ---------- device list from uci ----------
# columns: id  mac  down_kbps  up_kbps  limit  block  pause  alias  uci_section
#          quota_daily_mb  quota_monthly_mb
collect_uci() {
	: > "$DEVS.new"
	config_load apman
	config_foreach emit_device device
	mv "$DEVS.new" "$DEVS"
}

emit_device() {
	local id mac down up lim block pause alias sec qdm qmm
	config_get mac "$1" mac
	[ -n "$mac" ] || return 0
	mac=$(echo "$mac" | tr 'A-F' 'a-f')
	id=$(echo "$mac" | tr -d ':')
	config_get down "$1" down_kbps 0
	config_get up "$1" up_kbps 0
	config_get lim "$1" limit_enabled 0
	config_get block "$1" block 0
	config_get pause "$1" pause_until 0
	config_get alias "$1" alias ""
	config_get qdm "$1" quota_daily_mb 0
	config_get qmm "$1" quota_monthly_mb 0
	qdm=$(printf '%s' "$qdm" | tr -cd '0-9'); [ -n "$qdm" ] || qdm=0
	qmm=$(printf '%s' "$qmm" | tr -cd '0-9'); [ -n "$qmm" ] || qmm=0
	# keep the TSV column count stable: an empty field would collapse under
	# IFS=<tab> reads and shift the section name into the alias slot
	alias=$(printf '%s' "$alias" | tr '\t\n' '  ')
	[ -n "$alias" ] || alias=-
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$id" "$mac" "$down" "$up" "$lim" "$block" "$pause" "$alias" "$1" \
		"$qdm" "$qmm" >> "$DEVS.new"
}

# ---------- wifi bridge ports (have a phy80211 parent) ----------
# Only AP-side ports are client ports. A wifi UPLINK can also be a bridge port
# (mesh or WDS joined into the LAN, i.e. a wireless backhaul instead of a
# cable): it carries phy80211 too, but its frames are the whole LAN's traffic,
# not one client's. Treating it as a client port would rate-limit and account
# every client's traffic against the uplink, and would let the whitelist guard
# drop the traffic of devices that are not in the allowed set.
wifi_port_type() { # $1 = interface -> prints iw type, empty if unknown
	iw dev "$1" info 2>/dev/null | awk '/^[ 	]*type /{print $2; exit}'
}

collect_wifi_ports() {
	WIFI=$RUN/wifiports.tmp
	: > "$WIFI"
	if [ -n "$APMAN_WIFI_PORTS" ]; then
		printf '%s\n' "$APMAN_WIFI_PORTS" | tr ',' ' ' | tr ' ' '\n' | grep -v '^$' >> "$WIFI"
	else
		for p in /sys/class/net/$BRIDGE/brif/*; do
			[ -e "$p" ] || continue
			# brif/<port> symlinks to the port's brport dir (not the
			# netdev dir), so test phy80211 via /sys/class/net/<portname>
			n=$(basename "$p")
			[ -e "/sys/class/net/$n/phy80211" ] || continue
			# Only a managed/STA interface is certainly an uplink: it joins
			# someone else's network instead of serving clients. mesh and
			# ad-hoc can be either side (a mesh AP serves clients), so they
			# are kept: excluding them would silently disable policing on a
			# mesh AP, which is worse than the risk of an unusual bridged
			# backhaul being treated as a client port.
			case "$(wifi_port_type "$n")" in
				managed|station|monitor)
					continue ;; # uplink side, not a client port
			esac
			echo "$n" >> "$WIFI"
		done
	fi
	sort -u -o "$WIFI" "$WIFI"
}

# ---------- LAN prefixes: what a wifi client may still reach ----------
# Whitelist mode needs no gateway and no default route, because a bridge-mode
# AP (the normal setup here) has neither, it is just a bridge with an address.
# The guard allows the LAN prefixes the bridge itself carries, plus DHCP/ARP,
# link-local and multicast, and drops everything else arriving from wifi ports.
# Wired ports are never matched, so wired clients are never affected.
# Empty result => whitelist stays off (fail open): locking every wifi client
# out because an address is momentarily missing is worse than not filtering.
collect_lannet() {
	LAN4=$RUN/lan4.tmp
	LAN6=$RUN/lan6.tmp
	: > "$LAN4"
	: > "$LAN6"
	if [ -n "$APMAN_LAN_NETS" ]; then
		printf '%s\n' "$APMAN_LAN_NETS" | tr ', ' '\n\n' | grep -v '^$' \
			| grep -v ':' >> "$LAN4"
		printf '%s\n' "$APMAN_LAN_NETS" | tr ', ' '\n\n' | grep ':' \
			| grep -v '^fe80:' >> "$LAN6"
	else
		# every address the LAN bridge carries (nft canonicalises host bits)
		ip -o -4 addr show dev "$BRIDGE" 2>/dev/null | awk '{print $4}' >> "$LAN4"
		ip -o -6 addr show dev "$BRIDGE" 2>/dev/null | awk '{print $4}' \
			| grep -v '^fe80:' >> "$LAN6"
	fi
	sort -u -o "$LAN4" "$LAN4" 2>/dev/null || :
	sort -u -o "$LAN6" "$LAN6" 2>/dev/null || :
}

# ---------- whitelist mode: allowed = managed, not blocked/paused ----------
collect_allowed() {
	ALLOWED=$RUN/allowed.tmp
	NOW=$(date +%s)
	: > "$ALLOWED"
	while IFS='	' read -r id mac down up lim block pause alias sec qdm qmm; do
		[ -n "$mac" ] || continue
		[ "$block" = 1 ] && continue
		# pause_until is a timestamp; only a future one excludes the device
		case "$pause" in
			''|*[!0-9]*) pause=0 ;;
		esac
		[ "$pause" -gt "$NOW" ] 2>/dev/null && continue
		printf '%s\n' "$mac" >> "$ALLOWED"
	done < "$DEVS"
}

# ---------- current counters: "name<TAB>bytes" ----------
read_counters() {
	nft --terse list table bridge apman 2>/dev/null | awk '
		/^\t*counter (up|dn)_[0-9a-f]+ \{/ { key = $2; sub(/\{/, "", key); want = 1; next }
		want && /packets/ {
			by = 0
			for (i = 1; i <= NF; i++) if ($i == "bytes") by = $(i + 1)
			print key "\t" by; want = 0
		}'
}

# ---------- exclusions ----------
collect_exclusions() {
	EXCL=$RUN/excl.tmp
	{
		echo "00:00:00:00:00:00"
		# our own MACs (bridge + member ports)
		cat /sys/class/net/$BRIDGE/address 2>/dev/null
		for p in /sys/class/net/$BRIDGE/brif/*; do
			cat "$p/address" 2>/dev/null
		done
		# default gateway MAC (the modem): usually all internet traffic
		# would otherwise land in the unknown-devices list
		local gw mac
		gw=$(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')
		[ -n "$gw" ] && ip neigh show "$gw" 2>/dev/null | awk -v gw="$gw" '$1==gw {print $5}'
		# user-ignored MACs (comma-separated uci string)
		local ign m
		ign=$(read_setting ignored_macs "")
		if [ -n "$ign" ]; then
			echo "$ign" | tr ',' '\n'
		fi
	} | tr 'A-F' 'a-f' | grep -E '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' | sort -u > "$EXCL"
}

# ---------- main ----------
if [ -n "$APMAN_DEVICES_TSV" ]; then
	cp "$APMAN_DEVICES_TSV" "$DEVS"
else
	collect_uci
fi

# snapshot counters before regenerating
read_counters > "$RUN/counters.tmp"
CNT=$(cat "$RUN/counters.tmp" 2>/dev/null)

collect_exclusions
collect_wifi_ports
collect_lannet
collect_allowed

ENABLED=$(read_setting enabled 1)
[ "$ENABLED" = 1 ] || DISABLED=1
# whitelist (default-deny) mode: off | on | forced. 'on' only engages when a
# gateway MAC is known, so a missing default route can never lock out the LAN
WL=$(read_setting whitelist 0)
case "$WL" in
	1|on|forced|yes|true) WLON=1 ;;
	*) WLON=0 ;;
esac
[ "$WL" = forced ] && WLON=1

OUT() { printf '%s\n' "$1" >> "$GEN"; }

: > "$GEN"
# flush keeps sets/counters, which makes redefinition EBUSY; delete the whole
# table instead (skipped on first run), then recreate in the same transaction
if nft list table bridge apman >/dev/null 2>&1; then
	OUT "delete table bridge apman"
fi
OUT "table bridge apman {"

# constant exclusion set (nft rejects an empty elements block, so emit it
# only when there is at least one member)
: > "$GEN.el"
while IFS= read -r m; do
	[ -n "$m" ] && echo "$m" >> "$GEN.el"
done < "$EXCL"
# managed MACs are not "unknown" either
while IFS='	' read -r id mac _; do
	[ -n "$mac" ] && echo "$mac" >> "$GEN.el"
done < "$DEVS"
if [ -s "$GEN.el" ]; then
	OUT "	set nodisc { type ether_addr; flags constant; elements = {"
	while IFS= read -r m; do
		OUT "		$m ,"
	done < "$GEN.el"
	OUT "	} }"
else
	OUT "	set nodisc { type ether_addr; flags constant; }"
fi

OUT "	set unknown_up { type ether_addr; flags dynamic,timeout; counter; size 512; timeout 6h; }"
OUT "	set unknown_dn { type ether_addr; flags dynamic,timeout; counter; size 512; timeout 6h; }"

# wifi port set: limits and usage accounting only match these ports
if [ -s "$WIFI" ]; then
	OUT "	set wifports { type ifname; flags interval; elements = {"
	while IFS= read -r p; do
		[ -n "$p" ] && OUT "		\"$p\" ,"
	done < "$WIFI"
	OUT "	} }"
else
	OUT "	set wifports { type ifname; flags interval; }"
fi

# blocked set: block=1 or pause_until in the future
NOW=$(date +%s)
: > "$GEN.el"
while IFS='	' read -r id mac down up lim block pause alias sec qdm qmm; do
	[ "$block" = 1 ] && echo "$mac" >> "$GEN.el"
	[ -n "$pause" ] && [ "$pause" -gt 0 ] 2>/dev/null && [ "$pause" -gt "$NOW" ] 2>/dev/null \
		&& echo "$mac" >> "$GEN.el"
done < "$DEVS"
if [ -s "$GEN.el" ]; then
	OUT "	set blocked { type ether_addr; flags constant; elements = {"
	while IFS= read -r m; do
		OUT "		$m ,"
	done < "$GEN.el"
	OUT "	} }"
else
	OUT "	set blocked { type ether_addr; flags constant; }"
fi

# over-quota set: MACs the collector marked over a daily/monthly usage cap
: > "$GEN.el"
if [ -f "$QUOTA" ]; then
	while IFS= read -r m; do
		[ -n "$m" ] && echo "$m" >> "$GEN.el"
	done < "$QUOTA"
fi
if [ -s "$GEN.el" ]; then
	OUT "	set overquota { type ether_addr; flags constant; elements = {"
	while IFS= read -r m; do
		OUT "		$m ,"
	done < "$GEN.el"
	OUT "	} }"
else
	OUT "	set overquota { type ether_addr; flags constant; }"
fi
rm -f "$GEN.el"

# named counters for every managed device, seeded with preserved values
# (nft requires `counter name X` references to be declared in the same file)
while IFS='	' read -r id mac rest; do
	[ -n "$id" ] || continue
	bytes=$(printf '%s\n' "$CNT" | awk -F'\t' -v n="up_$id" '$1==n {print $2; exit}')
	[ -n "$bytes" ] || bytes=0
	OUT "	counter up_$id { packets 0 bytes $bytes ; }"
	bytes=$(printf '%s\n' "$CNT" | awk -F'\t' -v n="dn_$id" '$1==n {print $2; exit}')
	[ -n "$bytes" ] || bytes=0
	OUT "	counter dn_$id { packets 0 bytes $bytes ; }"
done < "$DEVS"

OUT "	chain blockchain {"
OUT "		type filter hook prerouting priority -300; policy accept;"
OUT "		ether saddr @blocked drop"
OUT "		ether daddr @blocked drop"
OUT "	}"
# The daddr rule above only catches frames the bridge relays. On a router a
# download to the device is LOCALLY GENERATED and handed to the bridge, so
# it never enters the bridge's prerouting hook and the block would not
# stop it. The output hook is where that frame is finally transmitted, so
# the block needs a rule there too.
OUT "	chain blockchain_out {"
OUT "		type filter hook output priority -300; policy accept;"
OUT "		ether daddr @blocked drop"
OUT "	}"

# whitelist guard: unknown wifi MACs may talk to the LAN but not past the
# gateway. Placed before discovery so blocked clients are not learned as new.
WL_ACTIVE=0
if [ "$WLON" = 1 ] && [ -s "$LAN4" ]; then
	WL_ACTIVE=1
	# allowed devices skip the guard entirely (same as blocked/paused do)
	OUT "	set lan4 { type ipv4_addr; flags interval; elements = {"
	while IFS= read -r n; do
		[ -n "$n" ] && OUT "		$n ,"
	done < "$LAN4"
	OUT "	} }"
	if [ -s "$LAN6" ]; then
		OUT "	set lan6 { type ipv6_addr; flags interval; elements = {"
		while IFS= read -r n; do
			[ -n "$n" ] && OUT "		$n ,"
		done < "$LAN6"
		OUT "	} }"
	fi
	# 'allowed' always exists: an empty set must deny everyone, so the guard
	# rule can stay in its single form (no separate no-devices branch)
	OUT "	set allowed { type ether_addr; flags interval;"
	if [ -s "$ALLOWED" ]; then
		OUT "		elements = {"
		while IFS= read -r m; do
			[ -n "$m" ] && OUT "			$m ,"
		done < "$ALLOWED"
		OUT "		}"
	fi
	OUT "	}"
	OUT "	chain wlguard {"
	OUT "		type filter hook prerouting priority -200; policy accept;"
	OUT "		# allowed devices are exempt from every line below"
	OUT "		iifname @wifports ether saddr @allowed accept"
	OUT "		# DHCP, EAPOL (WPA handshake), ARP: wifi association keeps working"
	OUT "		iifname @wifports ip daddr 255.255.255.255 accept"
	OUT "		iifname @wifports udp dport 67 accept"
	OUT "		iifname @wifports ether type arp accept"
	OUT "		iifname @wifports ether type 0x888e accept"
	OUT "		# the LAN itself (printer, NAS, other clients, this AP's UI)"
	OUT "		iifname @wifports ip daddr @lan4 accept"
	# IPv6 needs its own allowances: link-local, our LAN prefix, multicast, and
	# the ICMPv6 that neighbour discovery (the v6 equivalent of ARP) rides on.
	# Router advertisements are multicast, so a blocked client keeps its address.
	OUT "		iifname @wifports ip6 daddr fe80::/10 accept"
	if [ -s "$LAN6" ]; then
		OUT "		iifname @wifports ip6 daddr @lan6 accept"
	fi
	OUT "		iifname @wifports ip6 daddr ff00::/8 accept"
	OUT "		iifname @wifports meta l4proto ipv6-icmp accept"
	# everything left over is off-LAN traffic from a non-allowed wifi client
	OUT "		iifname @wifports ether saddr != @allowed drop"
	OUT "	}"
fi

OUT "	chain discovery {"
OUT "		type filter hook prerouting priority -250; policy accept;"
OUT "		ether saddr != @nodisc add @unknown_up { ether saddr }"
OUT "		ether daddr & 01:00:00:00:00:00 == 00:00:00:00:00:00 ether daddr != @nodisc add @unknown_dn { ether daddr }"
OUT "	}"
# The unknown_dn rule above only counts frames the bridge RELAYS. On a
# router the download is locally generated and handed to the bridge, so it
# never enters the bridge's prerouting hook and the device's download
# bytes were never counted. The output hook sees those frames.
# A frame is either relayed (prerouting) or generated locally (output),
# never both, so the two hooks never add the same bytes twice.
OUT "	chain discovery_out {"
OUT "		type filter hook output priority -250; policy accept;"
OUT "		ether daddr & 01:00:00:00:00:00 == 00:00:00:00:00:00 ether daddr != @nodisc add @unknown_dn { ether daddr }"
OUT "	}"

if [ -z "$DISABLED" ]; then
	# lim_ul: frames sent BY the device on a wifi port = its upload
	OUT "	chain lim_ul {"
	OUT "		type filter hook prerouting priority -150; policy accept;"
	while IFS='	' read -r id mac down up lim block pause alias sec qdm qmm; do
		[ "$lim" = 1 ] || continue
		if [ -n "$up" ] && [ "$up" -gt 0 ] 2>/dev/null; then
			BPS=$((up * 125))
			BURST=$((BPS / 8)); [ "$BURST" -lt 16384 ] && BURST=16384
			OUT "		iifname @wifports ether saddr $mac limit rate over $BPS bytes/second burst $BURST bytes drop"
		fi
	done < "$DEVS"
	OUT "	}"

	# quota_ul: over-quota upload from a wifi port
	OUT "	chain quota_ul {"
	OUT "		type filter hook prerouting priority -140; policy accept;"
	OUT "		iifname @wifports ether saddr @overquota drop"
	OUT "	}"

	OUT "	chain acc_up {"
	OUT "		type filter hook prerouting priority -100; policy accept;"
	while IFS='	' read -r id mac rest; do
		OUT "		iifname @wifports ether saddr $mac counter name up_$id"
	done < "$DEVS"
	OUT "	}"

	# ---------- download: rules for the forward AND the output hook ----------
	# The egress port is only known once the frame is on its way out, but
	# WHICH hook sees it depends on how the client is served:
	#   forward : the bridge relays the frame (dumb AP, the uplink is itself
	#             a bridge port). Received on one port, sent out of another.
	#   output  : the AP's own IP stack routes the frame (a router: WAN is a
	#             separate, non-bridge interface) and then hands it to the
	#             bridge, which transmits it out of the wifi port. The bridge
	#             never "forwards" such a frame, so NF_BR_FORWARD stays empty.
	# A frame is either relayed by the bridge or generated locally, never
	# both, so the two hooks never count the same bytes twice.
	DL_RULES=$RUN/dlrules.tmp
	: > "$DL_RULES"
	while IFS='	' read -r id mac down up lim block pause alias sec qdm qmm; do
		[ "$lim" = 1 ] || continue
		if [ -n "$down" ] && [ "$down" -gt 0 ] 2>/dev/null; then
			BPS=$((down * 125))
			BURST=$((BPS / 8)); [ "$BURST" -lt 16384 ] && BURST=16384
			echo "oifname @wifports ether daddr $mac limit rate over $BPS bytes/second burst $BURST bytes drop" >> "$DL_RULES"
		fi
	done < "$DEVS"

	# lim_dl: rate limit on the device's download
	OUT "	chain lim_dl {"
	OUT "		type filter hook forward priority -150; policy accept;"
	while IFS= read -r r; do
		[ -n "$r" ] && OUT "		$r"
	done < "$DL_RULES"
	OUT "	}"
	OUT "	chain lim_dl_out {"
	OUT "		type filter hook output priority -150; policy accept;"
	while IFS= read -r r; do
		[ -n "$r" ] && OUT "		$r"
	done < "$DL_RULES"
	OUT "	}"

	# quota_dl: over-quota download leaving via a wifi port
	OUT "	chain quota_dl {"
	OUT "		type filter hook forward priority -140; policy accept;"
	OUT "		oifname @wifports ether daddr @overquota drop"
	OUT "	}"
	OUT "	chain quota_dl_out {"
	OUT "		type filter hook output priority -140; policy accept;"
	OUT "		oifname @wifports ether daddr @overquota drop"
	OUT "	}"

	# acc_dn: download counters. One counter per device, referenced from
	# both hooks, so a device that is sometimes relayed and sometimes routed
	# still lands in a single total.
	OUT "	chain acc_dn {"
	OUT "		type filter hook forward priority -100; policy accept;"
	while IFS='	' read -r id mac rest; do
		OUT "		oifname @wifports ether daddr $mac counter name dn_$id"
	done < "$DEVS"
	OUT "	}"
	OUT "	chain acc_dn_out {"
	OUT "		type filter hook output priority -100; policy accept;"
	while IFS='	' read -r id mac rest; do
		OUT "		oifname @wifports ether daddr $mac counter name dn_$id"
	done < "$DEVS"
	OUT "	}"
	rm -f "$DL_RULES"
fi

OUT "}"

# validate then load atomically; keep old rules on error
if ! nft -c -f "$GEN" 2>/dev/null; then
	echo "apman-apply: generated ruleset failed validation" >&2
	exit 1
fi
if ! nft -f "$GEN"; then
	echo "apman-apply: failed to load ruleset" >&2
	exit 1
fi

rm -f "$EXCL" "$WIFI" "$GEN" "$LAN4" "$LAN6" "$ALLOWED" "$RUN/counters.tmp" "$DEVS.new"
exit 0
